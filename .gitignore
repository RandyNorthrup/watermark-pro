# dependencies
node_modules/

# build output
dist/
.wrangler/
.vite/
coverage/
playwright-report/
test-results/
blob-report/
.tsbuildinfo
*.tsbuildinfo

# secrets and local config — never commit
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# logs
npm-debug.log*
*.log

# generated route tree (regenerated by @tanstack/router-plugin on every dev/build)

# Lighthouse HTML reports are regenerated by `npm run audit:lighthouse`; only the summary is tracked.
docs/lighthouse/**/*.html
