{
  // Tooling that runs under Node: Vite/Vitest/Playwright configs and e2e specs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2025"],
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.workers.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "e2e",
    // Shared by the audit scripts (Node type stripping) and the e2e suite.
    "scripts/lib/local-admin.ts",
    // Filesystem audit of the bundled font packages; imports the catalogue only.
    "src/client/fonts/catalogue.audit.test.ts"
  ]
}
