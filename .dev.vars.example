# Local overrides for Worker variables and secrets. Copy to `.dev.vars`
# (git-ignored) and fill in real values. Production values are set with
# `wrangler secret put <NAME>`; non-secret vars live in wrangler.jsonc.
#
# Every variable listed here is validated by src/worker/env.ts.

# Signs session cookies and tokens. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Optional overrides of the wrangler.jsonc defaults:
# APP_ENV=development            # development | test | staging | production
# APP_URL=http://localhost:5273  # public origin used in auth links
# EMAIL_PROVIDER=console         # console | cloudflare (console is refused in production)
# EMAIL_FROM=no-reply@lumafoil.com

# Optional Cloudflare Turnstile bot protection for sign-up and password reset.
# Both must be set together; leave both empty to run without a challenge.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile with the
# site's hostname. The site key is public (set it as a plain var in production);
# the secret key is a Worker secret.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional cloud file connections. Public client IDs, project number and Dropbox
# app key may be plain production vars. GOOGLE_PICKER_API_KEY is visible to the
# browser at runtime, but is stored as an encrypted Worker secret; never commit
# its value. Restrict that key to Picker and the required app/Google frame hosts.
# Set local values here to enable the provider buttons. Register a separate
# Google cloud Web client, a Microsoft SPA client with delegated Files.ReadWrite
# and User.Read, and a Dropbox App Folder client with PKCE, file/sharing scopes,
# Chooser hosts and callbacks. Authorize the production origin and localhost:5273;
# see docs/verification/m19/domain-migration.md for the exact callback paths.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_PICKER_API_KEY=
# GOOGLE_PICKER_APP_ID=
# MICROSOFT_CLIENT_ID=
# DROPBOX_APP_KEY=

# Optional ACCOUNT identity providers (confidential Web clients; secrets stay server-side).
# Both fields in each provider pair must be set together.
# Production callbacks:
#   https://lumafoil.com/api/auth/callback/google
#   https://lumafoil.com/api/auth/callback/microsoft
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=
# MICROSOFT_AUTH_CLIENT_ID=
# MICROSOFT_AUTH_CLIENT_SECRET=
# MICROSOFT_AUTH_TENANT_ID=common
