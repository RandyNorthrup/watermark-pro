# Local overrides for Worker variables and secrets. Copy to `.dev.vars`
# (git-ignored) and fill in real values. Production values are set with
# `wrangler secret put <NAME>`; non-secret vars live in wrangler.jsonc.
#
# Every variable listed here is validated by src/worker/env.ts.

# Signs session cookies and tokens. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Optional overrides of the wrangler.jsonc defaults:
# APP_ENV=development            # development | test | staging | production
# APP_URL=http://localhost:5173  # public origin used in auth links
# EMAIL_PROVIDER=console         # console | cloudflare (console is refused in production)
# EMAIL_FROM=no-reply@watermark.blowmoney.net
