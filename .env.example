# The Worker reads configuration from wrangler.jsonc and .dev.vars, not from
# .env. This file exists so tooling that expects one finds the documented
# variables; see .dev.vars.example for the authoritative list.
#
# `npm run cf-typegen` passes this file as --env-file so the committed
# worker-configuration.d.ts never depends on whatever secrets a developer has
# in .dev.vars (CI has none) and stays byte-identical everywhere.
APP_ENV=development
