{
  // React SPA: DOM libraries, JSX, Vite client types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.client.tsbuildinfo"
  },
  "include": ["src/client", "src/shared"],
  "exclude": ["src/client/engine/worker.ts"]
}
