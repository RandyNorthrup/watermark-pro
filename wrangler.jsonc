{
  // Cloudflare Worker configuration. One Worker serves the SPA from Static
  // Assets and the API from src/worker.
  //
  // The top level is the LOCAL DEVELOPMENT configuration: `vite dev`, `vite
  // preview` and the test projects read it. It is deliberately named
  // `watermark-pro-dev`, has no routes and no workers.dev subdomain, so an
  // accidental `wrangler deploy` without an environment cannot overwrite
  // production. Production lives under `env.production` and is served at
  // lumafoil.com (PLAN.md R15); deploy it with `npm run deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watermark-pro-dev",
  "main": "src/worker/index.ts",
  // Pin the runtime behaviour to a date. Bump deliberately, never silently.
  // Must not exceed the newest date supported by the workerd bundled with
  // @cloudflare/vitest-pool-workers (2026-08-22 as of pool 0.22.0), or the
  // Workers test project fails to start.
  "compatibility_date": "2026-08-22",
  // Better Auth needs the Node compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    // Everything that is not an API route is served from the asset store
    // without invoking the Worker; unknown paths fall back to index.html so
    // client-side routing works on a hard refresh.
    //
    // The Worker runs first for `/api/*` and for `/`: the root goes through the
    // Worker so it can serve the prerendered, per-locale static landing
    // (src/worker/routes/landing.ts). The binding lets that handler read the
    // prerendered files (dist/client/landing/<locale>.html) and the SPA shell.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/privacy",
      "/terms",
      "/oauth/microsoft",
      "/oauth/microsoft/",
      "/oauth/microsoft.html",
      "/oauth/microsoft-bridge.js",
    ],
  },
  "observability": {
    // Custom console logs retain bearer paths in platform metadata even when
    // invocation logs are disabled. Application diagnostics remain in D1.
    "enabled": false,
    "redact_query_string": true,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false,
    },
    "traces": {
      "enabled": false,
      "persist": false,
    },
  },
  // Scheduled health check (M19): the `scheduled` handler in src/worker/index.ts
  // confirms the database is reachable every five minutes and records the result
  // for the admin console. No dashboard.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    // Non-secret configuration. Secrets (BETTER_AUTH_SECRET) go in .dev.vars
    // locally and `wrangler secret put --env production` in production. Every
    // entry here is validated by src/worker/env.ts on the first request an
    // isolate handles.
    "APP_ENV": "development",
    "APP_URL": "http://localhost:5273",
    "EMAIL_PROVIDER": "console",
    "EMAIL_FROM": "no-reply@lumafoil.com",
    // Cloud import pickers (M16) are configured under env.production below, like
    // TURNSTILE_SITE_KEY: their public client-side keys are committed there. They
    // are deliberately absent from this local block so `wrangler types` leaves
    // them off the generated `Env` (matching how env.ts validates them as
    // optional); local development enables the pickers by setting the same five
    // keys in .dev.vars (which typegen and git ignore). See public/_headers and
    // PLAN.md §9 for the CSP allowances that move with them.
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watermark-pro",
      // Local development and tests use an embedded SQLite keyed by this id;
      // the same id is the real production database (`wrangler d1 create
      // watermark-pro`, 2026-09-06).
      "database_id": "e142b088-c663-4276-bd39-5ded21775fb1",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "watermark-pro",
    },
  ],
  "ratelimits": [
    // Authoritative limits. src/shared/constants.ts mirrors them so Better
    // Auth reports an accurate Retry-After; keep both in sync.
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      // Import-from-a-URL (M16): the Worker fetches on the user's behalf, so it
      // is rate limited per client. Mirrors IMPORT_RATE_LIMIT in constants.ts.
      "name": "IMPORT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "send_email": [
    {
      // Cloudflare Email Sending. Unused while EMAIL_PROVIDER is "console";
      // required when it is "cloudflare".
      "name": "SEND_EMAIL",
    },
  ],
  "env": {
    "production": {
      "name": "watermark-pro",
      "workers_dev": false,
      "routes": [
        {
          // Custom Domain: wrangler creates the DNS record and certificate on
          // deploy. The zone must live in the same Cloudflare account.
          "pattern": "lumafoil.com",
          "custom_domain": true,
        },
      ],
      "observability": {
        // Preserve the same privacy boundary in the resolved production build.
        "enabled": false,
        "redact_query_string": true,
        "logs": {
          "enabled": false,
          "invocation_logs": false,
          "persist": false,
        },
        "traces": {
          "enabled": false,
          "persist": false,
        },
      },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      // Repeated from the top level so production has the ASSETS binding and the
      // `/` worker-first route regardless of environment inheritance rules.
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/",
          "/privacy",
          "/terms",
          "/oauth/microsoft",
          "/oauth/microsoft/",
          "/oauth/microsoft.html",
          "/oauth/microsoft-bridge.js",
        ],
      },
      "vars": {
        "APP_ENV": "production",
        "APP_URL": "https://lumafoil.com",
        "EMAIL_PROVIDER": "cloudflare",
        "EMAIL_FROM": "no-reply@lumafoil.com",
        // Turnstile widget "watermark-pro" (managed mode, created 2026-09-06).
        // The site key is public; TURNSTILE_SECRET_KEY is a Worker secret.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEqUpxeDq6Tcw_bs",
        // Cloud import pickers (M16); see the top-level vars for why these are
        // public, non-secret identifiers. Same values as local development.
        "GOOGLE_OAUTH_CLIENT_ID": "33646039034-62bcsfbjdakffvvdjbr96kv13sl9sc1f.apps.googleusercontent.com",
        "GOOGLE_PICKER_APP_ID": "33646039034",
        "MICROSOFT_CLIENT_ID": "1165fcc2-276c-4dde-b83b-394d32441fad",
        "DROPBOX_APP_KEY": "n4p4sfvxnat9ccd",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "watermark-pro",
          "database_id": "e142b088-c663-4276-bd39-5ded21775fb1",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "watermark-pro",
        },
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "IMPORT_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "send_email": [
        {
          "name": "SEND_EMAIL",
        },
      ],
    },
  },
}
