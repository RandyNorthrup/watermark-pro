{
  "name": "watermark-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade photo watermarking on Cloudflare Workers: bulk jobs, watermark library, smart placement, editor, sharing, RBAC.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
    "lint:cycles": "dpdm --no-warning --no-tree --exit-code circular:1 -T src/client/main.tsx src/worker/index.ts",
    "lint:dup": "jscpd .",
    "typecheck": "tsc -b",
    "deadcode": "knip --treat-config-hints-as-errors",
    "test": "vitest run --coverage --project unit-client --project unit-worker && vitest run --project workers",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "gitleaks git --redact --no-banner .",
    "security:sast": "semgrep scan --config p/default --config p/typescript --config p/react --config p/secrets --error --metrics=off",
    "quality": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run deadcode && npm run lint:cycles && npm run lint:dup && npm run security:secrets && npm run security:audit && npm run test && npm run build",
    "quality:ci": "npm run quality",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.32",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "dpdm": "4.3.0",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jscpd": "5.1.2",
    "jsdom": "30.0.1",
    "knip": "6.34.0",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --max-warnings=0"
    ],
    "*.{json,jsonc,md,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
