{
  "name": "Lumafoil",
  "short_name": "Lumafoil",
  "description": "Watermark photos, videos, and PDFs. Reusable presets, offline editing, and optional workspace sync.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbf9f7",
  "theme_color": "#c86b82",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photos",
          "accept": ["image/png", "image/jpeg", "image/webp"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/app",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"]
      }
    }
  ]
}
