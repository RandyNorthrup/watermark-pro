{
  "name": "Watermark Pro",
  "short_name": "Watermark",
  "description": "Bulk photo watermarking with smart placement, a watermark library, an editor, and secure sharing.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfbfc",
  "theme_color": "#6d4de6",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "photos", "accept": ["image/png", "image/jpeg", "image/webp"] }]
    }
  },
  "file_handlers": [
    {
      "action": "/app",
      "accept": { "image/png": [".png"], "image/jpeg": [".jpg", ".jpeg"], "image/webp": [".webp"] }
    }
  ]
}
